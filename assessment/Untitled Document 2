2. Pseudocode
Pseudocode for insertion
INSERT(root, value)

1. If root is NULL
      Create a new node
      Store value in the node
      Set left and right to NULL
      Return new node

2. If value < root->data
      root->left = INSERT(root->left, value)

3. Else if value > root->data
      root->right = INSERT(root->right, value)

4. Return root
Pseudocode for counting leaf nodes
LEAFCOUNT(root)

1. If root is NULL
      Return 0

2. If root->left is NULL AND root->right is NULL
      Return 1

3. leftcount = LEAFCOUNT(root->left)
4. rightcount = LEAFCOUNT(root->right)

5. Return leftcount + rightcount
Pseudocode for counting non-leaf nodes
NONLEAFCOUNT(root)

1. If root is NULL
      Return 0

2. If root->left is NULL AND root->right is NULL
      Return 0

3. leftcount = NONLEAFCOUNT(root->left)
4. rightcount = NONLEAFCOUNT(root->right)

5. Return 1 + leftcount + rightcount
3. Complete C Program

#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *left;
    struct node *right;
};

// Function to insert a node
struct node* insert(struct node *root, int value)
{
    if (root == NULL)
    {
        struct node *newnode;
        newnode = (struct node*)malloc(sizeof(struct node));

        newnode->data = value;
        newnode->left = NULL;
        newnode->right = NULL;

        return newnode;
    }

    if (value < root->data)
    {
        root->left = insert(root->left, value);
    }
    else if (value > root->data)
    {
        root->right = insert(root->right, value);
    }
    else
    {
        printf("Duplicate value not allowed\n");
    }

    return root;
}

// Function to display BST
void inorder(struct node *root)
{
    if (root != NULL)
    {
        inorder(root->left);
        printf("%d ", root->data);
        inorder(root->right);
    }
}

// Function to count leaf nodes
int leafcount(struct node *root)
{
    if (root == NULL)
        return 0;

    if (root->left == NULL && root->right == NULL)
        return 1;

    return leafcount(root->left) +
           leafcount(root->right);
}

// Function to count non-leaf nodes
int nonleafcount(struct node *root)
{
    if (root == NULL)
        return 0;

    if (root->left == NULL && root->right == NULL)
        return 0;

    return 1 + nonleafcount(root->left) +
               nonleafcount(root->right);
}

// Main function
int main()
{
    struct node *root = NULL;

    int choice, value;

    do
    {
        printf("\n\n----- BINARY SEARCH TREE -----");
        printf("\n1. Insert");
        printf("\n2. Display");
        printf("\n3. Count Leaf Nodes");
        printf("\n4. Count Non-Leaf Nodes");
        printf("\n5. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter the value: ");
                scanf("%d", &value);

                root = insert(root, value);
                break;

            case 2:
                printf("BST Elements: ");
                inorder(root);
                break;

            case 3:
                printf("Number of Leaf Nodes = %d",
                       leafcount(root));
                break;

            case 4:
                printf("Number of Non-Leaf Nodes = %d",
                       nonleafcount(root));
                break;

            case 5:
                printf("Exiting...");
                break;

            default:
                printf("Invalid choice");
        }

    } while(choice != 5);

    return 0;
}

