Question 1 – Doubly Linked List (Maximum and Minimum)
Algorithm
Start.

Declare a structure Node containing:

Integer variable data.

Pointer prev to the previous node.

Pointer next to the next node.

Declare head and ptr pointers and initialize head = NULL.

Read the number of nodes n.

Repeat the following steps n times:

Allocate memory for a new node.

Read the integer value into the new node.

Assign NULL to its next pointer.

If head == NULL:

Assign the new node to head.

Set its prev pointer to NULL.

Otherwise:

Traverse to the last node.

Link the last node's next to the new node.

Set the new node's prev to the last node.

Initialize max and min with the first node's data.

Set ptr = head.

Traverse the linked list until ptr == NULL:

If ptr->data > max, update max.

If ptr->data < min, update min.

Move ptr to the next node.

Display the maximum and minimum values.

Stop.

C Program

#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *prev;
    struct Node *next;
};

int main() {
    struct Node *head = NULL;
    struct Node *ptr, *newnode;

    int n, i, max, min, val;

    printf("Enter the number of nodes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        newnode = (struct Node*)malloc(sizeof(struct Node));

        printf("Enter value: ");
        scanf("%d", &val);

        newnode->data = val;
        newnode->next = NULL;

        if (head == NULL) {
            newnode->prev = NULL;
            head = newnode;
        }
        else {
            ptr = head;

            while (ptr->next != NULL) {
                ptr = ptr->next;
            }

            ptr->next = newnode;
            newnode->prev = ptr;
        }
    }

    ptr = head;

    max = ptr->data;
    min = ptr->data;

    while (ptr != NULL) {

        if (ptr->data > max) {
            max = ptr->data;
        }

        if (ptr->data < min) {
            min = ptr->data;
        }

        ptr = ptr->next;
    }

    printf("\nMaximum value = %d", max);
    printf("\nMinimum value = %d", min);

    return 0;
}

