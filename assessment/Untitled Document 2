Question 2 – Binary Search Tree (Count Leaf and Non-Leaf Nodes)
Algorithm
Start.

Declare a structure Node containing:

Integer variable data.

Pointer left to the left child.

Pointer right to the right child.

Initialize root = NULL.

Read the number of nodes n.

Repeat the following steps n times:

Allocate memory for a new node.

Read the integer value.

Assign NULL to its left and right pointers.

If root == NULL, assign the new node to root.

Otherwise:

Set ptr = root.

Compare the new value with ptr->data.

If the value is smaller, move to the left child.

If the value is greater, move to the right child.

Continue until an empty position is found.

Insert the new node at that position.

Initialize leaf = 0 and nonleaf = 0.

Insert the root node into a queue.

Repeat while the queue is not empty:

Remove a node from the queue.

If both left and right children are NULL, increment leaf.

Otherwise, increment nonleaf.

If the left child exists, insert it into the queue.

If the right child exists, insert it into the queue.

Display the number of leaf nodes and non-leaf nodes.

Stop.

C Program
This program uses a queue to traverse the BST level by level. It does not require separate insertion or counting functions.


#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *left;
    struct Node *right;
};

int main() {
    struct Node *root = NULL;
    struct Node *ptr, *newnode;

    struct Node *queue[100];

    int n, i, val;
    int front = 0, rear = 0;
    int leaf = 0, nonleaf = 0;

    printf("Enter the number of nodes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {

        newnode = (struct Node*)malloc(sizeof(struct Node));

        printf("Enter value: ");
        scanf("%d", &val);

        newnode->data = val;
        newnode->left = NULL;
        newnode->right = NULL;

        if (root == NULL) {
            root = newnode;
        }
        else {
            ptr = root;

            while (1) {

                if (val < ptr->data) {

                    if (ptr->left == NULL) {
                        ptr->left = newnode;
                        break;
                    }
                    else {
                        ptr = ptr->left;
                    }
                }

                else if (val > ptr->data) {

                    if (ptr->right == NULL) {
                        ptr->right = newnode;
                        break;
                    }
                    else {
                        ptr = ptr->right;
                    }
                }

                else {
                    printf("Duplicate value ignored.\n");
                    free(newnode);
                    break;
                }
            }
        }
    }

    if (root != NULL) {

        queue[rear++] = root;

        while (front < rear) {

            ptr = queue[front++];

            if (ptr->left == NULL &&
                ptr->right == NULL) {

                leaf++;
            }
            else {
                nonleaf++;
            }

            if (ptr->left != NULL) {
                queue[rear++] = ptr->left;
            }

            if (ptr->right != NULL) {
                queue[rear++] = ptr->right;
            }
        }
    }

    printf("\nNumber of leaf nodes = %d", leaf);
    printf("\nNumber of non-leaf nodes = %d", nonleaf);

    return 0;
}

