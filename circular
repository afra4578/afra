 #include <stdio.h>
#define MAX 5

int main()
{
    int queue[MAX];
    int front = -1, rear = -1;
    int choice, item, i;

    do
    {
        printf("\n1. ENQUEUE");
        printf("\n2. DEQUEUE");
        printf("\n3. DISPLAY");
        printf("\n4. EXIT");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                if ((rear + 1) % MAX == front)
                {
                    printf("Circular Queue Overflow\n");
                }
                else
                {
                    printf("Enter the item: ");
                    scanf("%d", &item);

                    if (front == -1)
                    {
                        front = 0;
                        rear = 0;
                    }
                    else
                    {
                        rear = (rear + 1) % MAX;
                    }

                    queue[rear] = item;
                }
                break;

            case 2:
                if (front == -1)
                {
                    printf("Circular Queue Underflow\n");
                }
                else
                {
                    printf("Deleted item = %d\n", queue[front]);

                    if (front == rear)
                    {
                        front = -1;
                        rear = -1;
                    }
                    else
                    {
                        front = (front + 1) % MAX;
                    }
                }
                break;

            case 3:
                if (front == -1)
                {
                    printf("Circular Queue is Empty\n");
                }
                else
                {
                    printf("Circular Queue elements: ");
                    i = front;

                    while (1)
                    {
                        printf("%d ", queue[i]);

                        if (i == rear)
                        {
                            break;
                        }

                        i = (i + 1) % MAX;
                    }

                    printf("\n");
                }
                break;

            case 4:
                printf("Exiting...\n");
                break;

            default:
                printf("Invalid Choice\n");
        }

    } while (choice != 4);

    return 0;
}
